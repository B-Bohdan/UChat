<Page x:Class="uchat.Views.Pages.MenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uchat.Views.Pages"
      xmlns:vmp="clr-namespace:uchat.ViewModels.VMPages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="MenuPage"
      d:DataContext="{d:DesignInstance Type=vmp:MainPageViewModel, IsDesignTimeCreatable=False}">

    <Border
        Background="{StaticResource BlurBackgroundBrush}">
        
        <Grid>
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Height="500"
                Width="400"
                CornerRadius="15"
                Background="{StaticResource BackgroundBrush}">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="160"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        CornerRadius="15,15,0,0"
                        Background="{StaticResource ChatPageBackgroundColorBrush}"/>

                    <!--Close menu button-->
                    <Button
                        Height="30"
                        Width="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,5,5,0"
                        Background="Transparent"
                        Command="{Binding HideMenuCommand}"
                        Style="{StaticResource BackgroundButtonStyle}">

                        <Image
                            Width="15"
                            Source="../Assets/close.png"/>
                    </Button>

                    <!--Profile avatar-->
                    <Grid>
                        <Ellipse
                            Grid.Row="0"
                            Height="115"
                            Width="115"
                            Margin="0,15,0,0"
                            Stretch="Uniform"
                            Fill="{StaticResource ChatIconBackgroundColorBrush}">
                        </Ellipse>

                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="{Binding ApplicationState.LoggedUser.Initials}"
                            FontSize="35"
                            Margin="0,15,0,0"
                            FontWeight="SemiBold"/>
                    </Grid>

                    <!--User full name-->
                    <TextBlock
                        Grid.Row="1"
                        Foreground="{StaticResource ProfileDataFieldsForegroundBrush}"
                        Text="{Binding ApplicationState.LoggedUser.FullName}"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        FontSize="23"/>

                    <!--User Email-->
                    <Grid
                        VerticalAlignment="Bottom"
                        Grid.Row="2"
                        Margin="5,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            x:Name="EmailField"
                            Margin="15,5,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ProfileDataFieldsForegroundBrush}"
                            Text="{Binding ApplicationState.LoggedUser.Email}"/>

                        <Button
                            x:Name="CopyEmailBtn"
                            Grid.Column="1"
                            Height="30"
                            Width="30"
                            Style="{StaticResource ModerdButtonStyle}"
                            Click="CopyEmailBtn_Click">

                            <Image
                                Width="20"
                                Source="/Views/Assets/copy.png"/>
                        </Button>
                    </Grid>

                    <Button
                        Grid.Row="4"
                        Style="{StaticResource ModerdButtonStyle}"
                        Margin="0,0,0,15"
                        Width="200"
                        Content="Log out"
                        FontWeight="SemiBold"
                        FontSize="13"
                        Command="{Binding LogOutCommand}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Page>
