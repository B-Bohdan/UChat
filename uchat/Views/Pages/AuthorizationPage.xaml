<Page x:Class="uchat.Views.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uchat.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorizationPage">

    <Border Background="{StaticResource BackgroundBrush}">
        <Grid>

            <Grid
                Height="auto"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <!--Header-->
                <TextBlock
                    Grid.Row="0"
                    Text="Uchat"
                    Foreground="{StaticResource LogoForegroundColorBrush}"
                    HorizontalAlignment="Center"
                    FontSize="35"
                    FontWeight="SemiBold"/>

                <!--Logo-->
                <Viewbox
                    Stretch="Uniform"
                    Width="100"
                    Grid.Row="1"
                    HorizontalAlignment="Center">

                    <Path
                        Fill="{StaticResource AccentBrush}"
                        Grid.Row="1">
                        <Path.Data>
                            <StaticResource ResourceKey="Logo"/>
                        </Path.Data>

                        <Path.RenderTransform>
                            <TranslateTransform X="-30" Y="0" />
                        </Path.RenderTransform>
                    </Path>
                </Viewbox>

                <!--Login button/buttons-->
                <StackPanel
                    Grid.Row="2"
                    Margin="0,20,0,0"
                    Orientation="Vertical">

                    <Button 
                        Style="{DynamicResource LoginButtonStyle}" 
                        x:Name="LoginBtn"
                        Height="30">
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Page>
