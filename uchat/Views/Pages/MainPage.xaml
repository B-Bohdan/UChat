<Page x:Class="uchat.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uchat.Views.Pages"
      xmlns:vmp="clr-namespace:uchat.ViewModels.VMPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage"
      d:DataContext="{d:DesignInstance Type=vmp:MainPageViewModel, IsDesignTimeCreatable=False}"
      Background="White">

    <Border
        Background="{StaticResource BackgroundBrush}">

        <Grid>
            <Grid.ColumnDefinitions>
                <!--Side Panel-->
                <ColumnDefinition Width="0.3*"/>
                <!--Selected Chat Panel-->
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <!--Side Panel-->
            <Grid
                Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <!--Logo and menu button-->
                <Border
                    BorderThickness="0,0,0,1"
                    BorderBrush="#1f2023">
                    <Grid
                        Grid.Row="0">

                        <!--Logo and header-->
                        <StackPanel
                            Margin="40,10,0,5"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <Viewbox
                                Stretch="Uniform"
                                Height="60">

                                <Path
                                    Fill="{StaticResource AccentBrush}">
                                    <Path.Data>
                                        <StaticResource ResourceKey="Logo"/>
                                    </Path.Data>

                                    <Path.RenderTransform>
                                        <TranslateTransform X="-30" Y="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Viewbox>

                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource LogoForegroundColorBrush}"
                                Text="Uchat"/>
                        </StackPanel>

                        <Button
                            Height="30"
                            Width="30"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"
                            Command="{Binding ShowMenuCommand}"
                            Style="{StaticResource MenuButtonStyle}"
                            ToolTip="Open menu"/>
                    </Grid>
                </Border>

                <!--Search bar-->
                <TextBox Style="{DynamicResource SearchBarStyle}"
                    Grid.Row="1"
                    Margin="10,0,10,0"/>

                <!--Search button-->
                <Border
                    CornerRadius="5"
                    Background="{StaticResource BackgroundBrush}"
                    Grid.Row="1"
                    Height="30"
                    Width="30"
                    HorizontalAlignment="Right"
                    Margin="0,0,10,0">

                    <!--Search button-->
                    <Button Style="{DynamicResource ModerdButtonStyle}" ToolTip="To Find!">
                        <Image
                            Width="17"
                            Source="../Assets/search.png"/>
                    </Button>
                </Border>

                <ListBox 
                    ItemsSource="{Binding ApplicationState.Chats}"
                    Grid.Row="2"
                    Background="Transparent"
                    BorderThickness="0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Margin="0,10,0,0">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#1f2023"/>
                            <Setter Property="Height" Value="50"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="5" >

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>

                                                <!--Icon-->
                                                <Ellipse
                                                    Grid.Column="0"
                                                    Height="35"
                                                    Width="35"
                                                    Stretch="Uniform"
                                                    Fill="{StaticResource ChatIconBackgroundColorBrush}">
                                                </Ellipse>

                                                <Image
                                                    Grid.Column="0"
                                                    Width="20"
                                                    Source="../Assets/chat_icon.png"/>

                                                <StackPanel
                                                    VerticalAlignment="Center"
                                                    Grid.Column="1"
                                                    Orientation="Vertical"
                                                    Margin="0,0,5,0">

                                                    <!--Name-->
                                                    <TextBlock
                                                        Text="{Binding Tag}"
                                                        TextTrimming="CharacterEllipsis"
                                                        FontSize="13"
                                                        Foreground="{StaticResource ChatNameForegroundBrush}"/>

                                                    <!--Last message-->
                                                    <TextBlock
                                                        Text="{Binding LastMessagePreview}"
                                                        TextTrimming="CharacterEllipsis"
                                                        FontSize="11"
                                                        Foreground="{StaticResource ChatLastMessageForegroundBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ChatMouseOveringBackgroundColorBrush}"/>
                                            </Trigger>

                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{StaticResource ChatSelectionBackgroundColorBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button
                    Grid.Row="2"
                    Height="35"
                    Width="35"
                    Style="{StaticResource ModerdButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10"
                    ToolTip="Create new chat">

                    <Image
                        Width="20"
                        Source="../Assets/add.png"/>
                </Button>
            </Grid>


            <Frame
                Grid.Column="1"
                Source="ChatPage.xaml">
            </Frame>

            <Frame
                x:Name="profileFrame"
                Visibility="{Binding MenuVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                Grid.ColumnSpan="2">
            </Frame>
        </Grid>
    </Border>
</Page>
