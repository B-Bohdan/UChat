<Page x:Class="uchat.Views.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uchat.Views.Pages"
      xmlns:vmp="clr-namespace:uchat.ViewModels.VMPages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="ChatPage"
      d:DataContext="{d:DesignInstance Type=vmp:ChatPageViewModel, IsDesignTimeCreatable=False}">

    <Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="auto" MaxHeight="150"/>
            </Grid.RowDefinitions>

            <!--Header-->
            <Grid
                Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Height="50"
                    Width="50"
                    Style="{StaticResource RoundButtonStyle}"
                    Command="{Binding OpenChatMenuCommand}">

                    <Image
                        Grid.Column="0"
                        Width="23"
                        Source="../Assets/chat_icon.png"/>
                </Button>

                <!--Chat name-->
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Text="{Binding ApplicationState.SelectedChat.Tag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Foreground="{StaticResource ChatNameForegroundBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"/>

                <Button
                    Grid.Column="2"
                    Style="{StaticResource ModerdButtonStyle}"
                    Height="30"
                    Width="30"
                    ToolTip="Invite new person"
                    Command="{Binding OpenSearchInvitePanelCommand}">

                    <Image
                        Width="25"
                        Source="../Assets/invite.png"/>
                </Button>
            </Grid>

            <!--Message container-->
            <ListBox
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0">

                <ListBox.Resources>
                    <ControlTemplate x:Key="IncomingMessageTemplate" TargetType="ListBoxItem">
                        <Grid Margin="10,5,50,5" HorizontalAlignment="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource SenderMessageBackgrounColorBrush}" 
                                    CornerRadius="15,15,15,0" 
                                    Grid.Row="0"
                                    Padding="10">
                                
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Foreground="{StaticResource SenderNameOnMessageForegroundBrush}"
                                        Text="Ivan Rusin"
                                        FontWeight="SemiBold"/>

                                    <TextBlock
                                        Foreground="{StaticResource SenderMessageTextForegroundBrush}"
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        TextWrapping="Wrap"
                                        MaxWidth="350"
                                        Text="Hello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello World"/>
                                </Grid>
                            </Border>

                            <TextBlock
                                Margin="10,5,0,0"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Grid.Row="1"
                                Text="2:29 PM"
                                Foreground="{StaticResource MessageTimeHintForegroundBrush}"/>
                        </Grid>
                    </ControlTemplate>

                    <ControlTemplate x:Key="OutgoingMessageTemplate" TargetType="ListBoxItem">
                        <Grid Margin="50,5,10,5" HorizontalAlignment="Right">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource AccentBrush}" 
                                    CornerRadius="15,15,0,15" 
                                    Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>

                                    <TextBlock
                                        Foreground="{StaticResource UserMessageTextForegroundBrush}"
                                        Grid.Row="1"
                                        TextWrapping="Wrap"
                                        MaxWidth="350"
                                        Text="Hello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello WorldHello World"/>
                                </Grid>
                            </Border>

                            <TextBlock
                                Margin="10,5,0,0"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Grid.Row="1"
                                Text="2:29 PM"
                                Foreground="{StaticResource MessageTimeHintForegroundBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </ListBox.Resources>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                        <Setter Property="Template" Value="{StaticResource IncomingMessageTemplate}"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                <Setter Property="Template" Value="{StaticResource OutgoingMessageTemplate}"/>
                            </DataTrigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!--Footer-->
            <Border
                Grid.Row="2"
                BorderThickness="0,1,0,0"
                MaxHeight="150"
                BorderBrush="#1f2023">
                <Grid
                    Margin="10,10,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <TextBox 
                        Style="{DynamicResource MessageFieldStyle}"
                        VerticalAlignment="Center"/>

                    <!--Send message button-->
                    <Button
                        Grid.Column="1"
                        Height="50"
                        Width="50"
                        Style="{StaticResource RoundButtonStyle}">

                        <Image
                            Width="25"
                            Source="../Assets/send.png"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Page>
