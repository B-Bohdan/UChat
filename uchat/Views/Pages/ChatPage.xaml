<Page x:Class="uchat.Views.Pages.ChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uchat.Views.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="ChatPage">

    <Border
        Background="{StaticResource ChatPageBackgroundColorBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition Height="auto" MaxHeight="150"/>
            </Grid.RowDefinitions>

            <!--Header-->
            <Grid
                Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!--Icon-->
                <Ellipse
                     Grid.Column="0"
                     Height="50"
                     Width="50"
                     Stretch="Uniform"
                     Fill="{StaticResource ChatIconBackgroundColorBrush}">
                </Ellipse>

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Text="Ivan Rusin"
                    Foreground="{StaticResource ChatNameForegroundBrush}"
                    FontSize="13"
                    FontWeight="SemiBold"/>
            </Grid>

            <!--Message container-->
            <ListBox
                Grid.Row="1"
                Background="Transparent"
                BorderThickness="0">

                <ListBox.Resources>
                    <ControlTemplate x:Key="IncomingMessageTemplate" TargetType="ListBoxItem">
                        <Grid Margin="0,5,50,5" HorizontalAlignment="Left">
                            <Border Background="#E5E5EA" 
                                    CornerRadius="15,15,15,0" 
                                    Padding="10">
                                <ContentPresenter />
                            </Border>
                        </Grid>
                    </ControlTemplate>

                    <ControlTemplate x:Key="OutgoingMessageTemplate" TargetType="ListBoxItem">
                        <Grid Margin="50,5,0,5" HorizontalAlignment="Right">
                            <Border Background="#0078D7" 
                                    CornerRadius="15,15,0,15" 
                                    Padding="10">
                                <ContentPresenter TextElement.Foreground="White"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </ListBox.Resources>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>

                        <Setter Property="Template" Value="{StaticResource IncomingMessageTemplate}"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMine}" Value="True">
                                <Setter Property="Template" Value="{StaticResource OutgoingMessageTemplate}"/>
                            </DataTrigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBoxItem/>
            </ListBox>

            <!--Footer-->
            <Border
                Grid.Row="2"
                BorderThickness="0,1,0,0"
                MaxHeight="150"
                BorderBrush="#1f2023">
                <Grid
                    Margin="10,10,0,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>

                    <TextBox 
                        Style="{DynamicResource MessageFieldStyle}"
                        VerticalAlignment="Center"/>

                    <!--Send message button-->
                    <Button
                        Grid.Column="1"
                        Height="50"
                        Width="50"
                        Style="{StaticResource RoundButtonStyle}">

                        <Image
                            Width="25"
                            Source="../Assets/send.png"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Page>
