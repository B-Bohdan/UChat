<Page x:Class="uchat.Views.Pages.SearchInviteChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:uchat.Views.Pages"
      xmlns:vmp="clr-namespace:uchat.ViewModels.VMPages"
      mc:Ignorable="d" 
      d:DesignHeight="550" d:DesignWidth="800"
      Title="SearchInviteChatPage"
      d:DataContext="{d:DesignInstance Type=vmp:ChatPageViewModel, IsDesignTimeCreatable=False}">

    <Border
        Background="{StaticResource BlurBackgroundBrush}">

        <Grid>
            <Border
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource BackgroundBrush}"
                Width="300"
                Height="250">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="90"/>
                        <RowDefinition/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>


                    <!--Header and search bar-->
                    <Grid
                        Grid.Row="0">

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Text="Search for user and add to chat"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource ChatIconBackgroundColorBrush}"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"/>

                        <TextBox
                            Grid.Row="1"
                            Margin="10,0,10,0"
                            Style="{StaticResource SearchBarStyle}"
                            Text="{Binding EnteredUserEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <!--Search button-->
                        <Border
                            CornerRadius="5"
                            Background="{StaticResource BackgroundBrush}"
                            Grid.Row="1"
                            Height="30"
                            Width="30"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0">

                            <!--Search button-->
                            <Button 
                                Style="{DynamicResource ModerdButtonStyle}"
                                Command="{Binding SearchForUserCommand}"
                                ToolTip="To Find!">
                                <Image
                                    Width="17"
                                    Source="../Assets/search.png"/>
                            </Button>
                        </Border>
                    </Grid>

                    <ListBox
                        ItemsSource="{Binding FoundedUsersToAdd}"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="{StaticResource ChatPageBackgroundColorBrush}"/>
                                <Setter Property="Height" Value="50"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <Border x:Name="bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="5" >

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse
                                                        Grid.Column="0"
                                                        Height="35"
                                                        Width="35"
                                                        Stretch="Uniform"
                                                        Fill="{StaticResource ChatIconBackgroundColorBrush}">
                                                    </Ellipse>

                                                    <TextBlock
                                                        Foreground="{StaticResource UserIconForegroundBrush}"
                                                        Text="{Binding Initials}"
                                                        Grid.Column="0"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontWeight="SemiBold"/>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Vertical">

                                                        <TextBlock
                                                            Text="{Binding FullName}"
                                                            FontWeight="SemiBold"
                                                            Foreground="{StaticResource UserFullNameForegroundBrush}"/>

                                                        <TextBlock
                                                            FontSize="11"
                                                            Text="{Binding Email}"
                                                            Foreground="{StaticResource UserEmailForegroundBrush}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Button
                        Grid.Row="2"
                        Style="{StaticResource ModerdButtonStyle}"
                        Margin="10"
                        Content="Add to chat"
                        Command="{Binding InviteToChatCommand}"/>

                    <!--Close menu button-->
                    <Button
                        Height="30"
                        Width="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,5,5,0"
                        Background="Transparent"
                        Style="{StaticResource BackgroundButtonStyle}"
                        Command="{Binding HideSearchInvitePanelCommand}">

                        <Image
                            Width="15"
                            Source="../Assets/close.png"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Page>
