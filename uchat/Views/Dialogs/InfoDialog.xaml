<Window x:Class="uchat.Views.Dialogs.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:uchat.Views.Dialogs"
        mc:Ignorable="d"
        Title="Information"
        Height="Auto" Width="400"
        MinHeight="150" MaxWidth="400" MinWidth="400"
        ShowInTaskbar="False" WindowStyle="None"
        SizeToContent="Height" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent">

    <Grid>
        <Border CornerRadius="10"
                BorderThickness="1"
                Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource AccentBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,30,20,30">
                    <Viewbox Width="45" Height="45" VerticalAlignment="Center">
                        <Path Data="M11,9H13V7H11M11,20H13V11H11V20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z" 
                              Fill="{StaticResource AccentBrush}" />
                    </Viewbox>

                    <TextBlock TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"
                               Width="260"
                               FontSize="14"
                               Foreground="White"
                               Text="{Binding Message, RelativeSource={RelativeSource AncestorType=local:InfoDialog}}"/>
                </StackPanel>

                <Border Grid.Row="1"
                        CornerRadius="0,0,10,10"
                        Background="{StaticResource SenderMessageBackgrounColorBrush}"
                        Padding="10">
                    <StackPanel HorizontalAlignment="Right">
                        <Button Click="Ok_Click"
                                Style="{StaticResource ModerdButtonStyle}"
                                Width="80" Height="30"
                                Content="Ok"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>